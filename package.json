{
  "name": "modeltraining-yolo26-desktop",
  "version": "0.3.1",
  "productName": "基于YOLO26的铝型方管缺陷智能分类检测系统",
  "description": "基于YOLO26的铝型方管缺陷智能分类检测系统",
  "main": "electron/main.cjs",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean:out": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path out) { Remove-Item out -Recurse -Force }\"",
    "clean:web": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path web/dist) { Remove-Item web/dist -Recurse -Force }\"",
    "runtime:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-portable-runtime.ps1",
    "runtime:rebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-portable-runtime.ps1 -Force",
    "runtime:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-portable-runtime.ps1",
    "runtime:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-runtime-release.ps1",
    "runtime:release:verify": "node electron/verify-runtime-release.cjs",
    "build:web": "npm run clean:web && npm --prefix web run build",
    "build:server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-server-win-x64.ps1",
    "build": "npm run build:web && npm run build:server",
    "test:electron": "node --test electron/*.test.cjs",
    "build:portable": "npm run runtime:prepare && npm run runtime:verify && npm run build",
    "electron:start": "npm run build:portable && electron-forge start",
    "package:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-packaged-app.ps1",
    "electron:package": "npm run clean:out && npm run build:portable && electron-forge package --platform=win32 --arch=x64 && npm run package:verify",
    "electron:make": "npm run clean:out && npm run build:portable && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-win-x64.ps1",
    "electron:installer": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-installer-win-x64.ps1",
    "release:app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-app-release.ps1",
    "release:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-runtime-release.ps1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "^42.4.1"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "extract-zip": "^2.0.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
